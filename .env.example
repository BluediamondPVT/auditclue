# 1. Auditclue CRM Lead Ingestion Webhook (Server-to-Server)
# Copy from CRM -> Leads -> Website Forms -> Get code -> Tab 2 (Use your own form)
# Format: https://crm.auditclue.app/webhooks/web-forms/1/<secret>
CRM_LEAD_WEBHOOK_URL=

# 2. Email Transport — Option A (Recommended / Easiest): SMTP (Nodemailer)
# Works with Gmail (16-digit App Password), Zoho, Outlook, or cPanel webmail
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 3. Email Transport — Option B: Resend REST API (if DNS is verified)
RESEND_API_KEY=

# 4. Recipient & CC Settings (used by /api/contact and /api/reviews)
NOTIFICATION_EMAIL=info@auditclue.com
NOTIFICATION_FROM_EMAIL=Auditclue Advisory <noreply@auditclue.com>
NOTIFICATION_CC_EMAIL=

# Review-specific overrides (defaults to NOTIFICATION_EMAIL and NOTIFICATION_CC_EMAIL if left empty)
REVIEW_TO_EMAIL=
REVIEW_CC_EMAIL=
